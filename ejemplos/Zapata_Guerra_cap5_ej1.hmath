   "t": "eq",
   "codigo": "η_q=",
   "modo": 0
  },
  {
   "t": "eq",
   "codigo": "FS_q=q_adm/σ_maxS",
   "modo": 0
  },
  {
   "t": "eq",
   "codigo": "FS_q=",
   "modo": 0
  },
  {
   "t": "eq",
   "codigo": "Δ_q=q_adm-σ_maxS % holgura [t/m²]",
   "modo": 0
  },
  {
   "t": "eq",
   "codigo": "Δ_q=",
   "modo": 0
  },
  {
   "t": "texto",
   "text": "2 · Excentricidad: e = My/(P + peso propio) debe caer dentro del núcleo central L/6; con σmin > 0 no hay despegue de la base.",
   "titulo": true,
   "nivel": 3
  },
  {
   "t": "eq",
   "codigo": "e_res=(M_yD+M_yL+(P_D+P_L)*x_c)/(P_D+P_L+W_S) % excentricidad de la resultante en x [m]: M_y y la columna desplazada x_c",
   "modo": 0
  },
  {
   "t": "eq",
   "codigo": "e_res=",
   "modo": 0
  },
  {
   "t": "eq",
   "codigo": "e_nuc=L/6 % límite del núcleo central [m]",
   "modo": 0
  },
  {
   "t": "eq",
   "codigo": "e_nuc=",
   "modo": 0
  },
  {
   "t": "eq",
   "codigo": "r_E=e_res/e_nuc",
   "modo": 0
  },
  {
   "t": "eq",
   "codigo": "r_E=",
   "modo": 0
  },
  {
   "t": "eq",
   "codigo": "e_resy=(P_D+P_L)*y_c/(P_D+P_L+W_S) % excentricidad en y [m] (columna desplazada y_c)",
   "modo": 0
