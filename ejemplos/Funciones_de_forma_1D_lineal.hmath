  "gap": 0,
  "fmt": 0,
  "items": [
    {
      "t": "texto",
      "text": "Funciones de forma 1D: elemento lineal de 2 nudos",
      "titulo": true,
      "mismaLinea": false
    },
    {
      "t": "texto",
      "text": "u(x) = N1·u1 + N2·u2 con N1 = (L − x)/L y N2 = x/L. Mueve los deslizadores.",
      "titulo": false,
      "mismaLinea": false
    },
    {
      "t": "slider",
      "nombre": "u1",
      "min": 0,
      "max": 2,
      "inc": 0.05,
      "valor": 1
    },
    {
      "t": "slider",
      "nombre": "u2",
      "min": 0,
      "max": 2,
      "inc": 0.05,
      "valor": 0.5
    },
    {
      "t": "slider",
      "nombre": "L",
      "min": 0.5,
      "max": 2,
      "inc": 0.1,
      "valor": 1
    },
    {
      "t": "eq",
      "ini": "",
      "teclas": "",
      "mismaLinea": false,
      "codigo": "s = 0:0 + 0.05 - 0:1\r\nxs = s*L\r\nN1 = 1 - s\r\nN2 = s\r\nu = N1*u1 + N2*u2",
      "oculto": true
    },
    {
      "t": "eq",
      "ini": "",
      "teclas": "",
      "mismaLinea": false,
      "codigo": "curvas(xs, N1, N2, u, \"N1\", \"N2\", \"u(x)\", \"Elemento lineal: N1, N2 y u(x)\", \"x\", \"valor\")"
    }
  ]
}